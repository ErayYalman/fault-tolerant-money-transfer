# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Transfer Service
POSTGRES_TRANSFER_DB=transfer_db
POSTGRES_TRANSFER_USER=transfer_user
POSTGRES_TRANSFER_PASSWORD=change_me

# Payment A Service
POSTGRES_PAYMENT_A_HOST=localhost
POSTGRES_PAYMENT_A_PORT=5433
PAYMENT_A_SERVER_PORT=8081
POSTGRES_PAYMENT_A_DB=payment_a_db
POSTGRES_PAYMENT_A_USER=payment_a_user
POSTGRES_PAYMENT_A_PASSWORD=change_me
KAFKA_PAYMENT_A_CONSUMER_GROUP_ID=payment-service-a

# Payment B Service
POSTGRES_PAYMENT_B_HOST=localhost
POSTGRES_PAYMENT_B_PORT=5434
PAYMENT_B_SERVER_PORT=8082
POSTGRES_PAYMENT_B_DB=payment_b_db
POSTGRES_PAYMENT_B_USER=payment_b_user
POSTGRES_PAYMENT_B_PASSWORD=change_me

# Reconciliation Service
RECONCILIATION_TIME_ZONE=Europe/Istanbul
RECONCILIATION_SERVER_PORT=8083
POSTGRES_RECONCILIATION_HOST=localhost
POSTGRES_RECONCILIATION_PORT=5435
POSTGRES_RECONCILIATION_DB=reconciliation_db
POSTGRES_RECONCILIATION_USER=reconciliation_user
POSTGRES_RECONCILIATION_PASSWORD=change_me

# Read-only API clients used by Reconciliation Service
TRANSFER_SERVICE_BASE_URL=http://localhost:8080
PAYMENT_A_SERVICE_BASE_URL=http://localhost:8081
PAYMENT_B_SERVICE_BASE_URL=http://localhost:8082
RECONCILIATION_CLIENT_PAGE_SIZE=500

# ML Service - Keycloak JWT validation
ML_SERVICE_BASE_URL=http://localhost:8090
ML_SERVICE_PORT=8090
ML_SERVICE_HOST_BIND=127.0.0.1
ML_TRAINING_ENDPOINT_ENABLED=false
KEYCLOAK_ISSUER=http://localhost:8180/realms/money-transfer
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/money-transfer/protocol/openid-connect/certs
KEYCLOAK_JWT_ALGORITHM=RS256
ML_OIDC_AUDIENCE=ml-service
ML_OIDC_AUTHORIZED_PARTY=reconciliation-service
ML_OIDC_REQUIRED_ROLE=anomaly-score

# Reconciliation scheduling
RECONCILIATION_SCHEDULE_ENABLED=true
RECONCILIATION_SCHEDULE_CRON=0 0 3 * * *

# API Gateway
API_GATEWAY_SERVER_PORT=8084
GATEWAY_TRANSFER_SERVICE_BASE_URL=http://localhost:8080
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s

# Keycloak Database
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=change_me

# Keycloak Admin
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=change_me

# Keycloak Server
KEYCLOAK_HOST_BIND=127.0.0.1
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Reconciliation Service - OAuth2 Client Credentials
RECONCILIATION_OIDC_CLIENT_ID=reconciliation-service
RECONCILIATION_OIDC_CLIENT_SECRET=change_me
KEYCLOAK_TOKEN_URI=http://localhost:8180/realms/money-transfer/protocol/openid-connect/token

# Transfer Service - Keycloak Resource Server
TRANSFER_KEYCLOAK_ISSUER=http://localhost:8180/realms/money-transfer
TRANSFER_KEYCLOAK_JWKS_URL=http://localhost:8180/realms/money-transfer/protocol/openid-connect/certs
TRANSFER_SERVICE_OIDC_AUDIENCE=transfer-service
