# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Transfer Service
POSTGRES_TRANSFER_DB=transfer_db
POSTGRES_TRANSFER_USER=transfer_user
POSTGRES_TRANSFER_PASSWORD=change_me

# Payment A Service
POSTGRES_PAYMENT_A_HOST=localhost
POSTGRES_PAYMENT_A_PORT=5433
PAYMENT_A_SERVER_PORT=8081
POSTGRES_PAYMENT_A_DB=payment_a_db
POSTGRES_PAYMENT_A_USER=payment_a_user
POSTGRES_PAYMENT_A_PASSWORD=change_me
KAFKA_PAYMENT_A_CONSUMER_GROUP_ID=payment-service-a

# Payment B Service
POSTGRES_PAYMENT_B_HOST=localhost
POSTGRES_PAYMENT_B_PORT=5434
PAYMENT_B_SERVER_PORT=8082
POSTGRES_PAYMENT_B_DB=payment_b_db
POSTGRES_PAYMENT_B_USER=payment_b_user
POSTGRES_PAYMENT_B_PASSWORD=change_me

# Reconciliation Service
RECONCILIATION_TIME_ZONE=Europe/Istanbul
RECONCILIATION_SERVER_PORT=8083
POSTGRES_RECONCILIATION_HOST=localhost
POSTGRES_RECONCILIATION_PORT=5435
POSTGRES_RECONCILIATION_DB=reconciliation_db
POSTGRES_RECONCILIATION_USER=reconciliation_user
POSTGRES_RECONCILIATION_PASSWORD=change_me

# Read-only API clients used by Reconciliation Service
TRANSFER_SERVICE_BASE_URL=http://localhost:8080
PAYMENT_A_SERVICE_BASE_URL=http://localhost:8081
PAYMENT_B_SERVICE_BASE_URL=http://localhost:8082
RECONCILIATION_CLIENT_PAGE_SIZE=500

# ML Anomaly Scoring Service
ML_SERVICE_BASE_URL=http://localhost:8090
ML_SERVICE_PORT=8090
ML_SERVICE_HOST_BIND=127.0.0.1
ML_TRAINING_ENDPOINT_ENABLED=false

# Reconciliation scheduling
RECONCILIATION_SCHEDULE_ENABLED=true
RECONCILIATION_SCHEDULE_CRON=0 0 3 * * *